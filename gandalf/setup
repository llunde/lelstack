#!/bin/sh
# Bootstrap a gandalf instance into a workspace root, or update an existing one. Idempotent.
# Usage: setup <workspace root> [--no-stubs]
# GANDALF_STUBS_DIR=<dir> installs the command stubs there instead of the user-level skill folders.
set -eu

SCHEMA=1 # red-book layout version; raise it together with a new migrations/<n>.sh

[ $# -ge 1 ] || { echo "usage: setup <workspace root> [--no-stubs]" >&2; exit 2; }
SRC=$(cd "$(dirname "$0")" && pwd -P)
ROOT=$(cd "$1" 2>/dev/null && pwd -P) || { echo "setup: no such directory: $1" >&2; exit 1; }
stubs=yes
[ "${2:-}" = --no-stubs ] && stubs=no
G="$ROOT/.gandalf"
VERSION=$(cat "$SRC/VERSION")
today=$(date +%F)

case $ROOT in "$SRC"|"$SRC"/*) echo "setup: the workspace can't be inside the gandalf source folder" >&2; exit 1 ;; esac
command -v git >/dev/null || { echo "setup: git is required" >&2; exit 1; }

conf() { sed -n "s/^$1=//p" "$G/instance.conf" 2>/dev/null | head -n 1; }

if [ -f "$G/instance.conf" ]; then
  mode=update; from=$(conf version); schema=$(conf schema); created=$(conf created)
  case $schema in
    ''|*[!0-9]*)
      echo "setup: $G/instance.conf has no valid schema= line ('$schema'); set it to the red book's schema and re-run" >&2
      exit 1 ;;
  esac
  if [ "$schema" -gt "$SCHEMA" ]; then
    echo "setup: this instance's red book is schema $schema, newer than this gandalf's $SCHEMA; use a newer lelstack" >&2
    exit 1
  fi
else
  mode=bootstrap; from=; schema=$SCHEMA; created=$today
fi

# A workspace root inside a git repo must not let that repo pick up the instance.
if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  top=$(git -C "$ROOT" rev-parse --show-toplevel)
  # Relative to $ROOT unless git prints it absolute. Not --path-format=absolute: that needs git 2.31.
  exclude=$(git -C "$ROOT" rev-parse --git-path info/exclude)
  case $exclude in /*) ;; *) exclude="$ROOT/$exclude" ;; esac
  line="${G#"$top"}/"
  mkdir -p "$(dirname "$exclude")"
  if ! grep -qxF "$line" "$exclude" 2>/dev/null; then
    echo "$line" >> "$exclude"
    echo "setup: $ROOT is inside the git repo $top; added $line to its .git/info/exclude"
  fi
fi

mkdir -p "$G"
# A local repo for the red book's history. It has no remote and is never pushed.
[ -d "$G/.git" ] || git -C "$G" init -q

# Workflow-owned: replaced wholesale. Staged first, so its save commits the instance before the swap.
rm -rf "$G/workflow.new"
trap 'rm -rf "$G/workflow.new"' EXIT # gone after the swap; left by an aborted run, a path-less save would commit it
cp -R "$SRC/workflow" "$G/workflow.new"
mkdir -p "$G/workflow.new/skills"
for s in check pr-text; do
  [ -d "$SRC/../skills/$s" ] && cp -R "$SRC/../skills/$s" "$G/workflow.new/skills/"
done
chmod +x "$G"/workflow.new/scripts/*
save="$G/workflow.new/scripts/save"
# <message> <path>...: only these, so another session's unfinished red-book edits stay out. save retries
# while another session holds git's lock, and fails if the commit does.
commit() { "$save" "$@" >/dev/null; }

# Keep the workflow files, and a red book about to be migrated, as they were: local edits included.
# Nothing is replaced or migrated unless that snapshot is committed.
if [ "$mode" = update ]; then
  set --
  [ -e "$G/workflow" ] && set -- "$G/workflow"
  [ "$schema" -lt "$SCHEMA" ] && [ -e "$G/red-book" ] && set -- "$@" "$G/red-book"
  [ $# -eq 0 ] || commit "gandalf: snapshot before update to $VERSION" "$@" || {
    echo "setup: couldn't commit a snapshot of $G, so nothing was replaced; fix committing there and re-run" >&2
    exit 1
  }
fi

mkdir -p "$G/red-book/projects" "$G/red-book/groups"
n=$schema
while [ "$n" -lt "$SCHEMA" ]; do
  n=$((n + 1))
  echo "setup: migrating the red book to schema $n"
  sh "$SRC/migrations/$n.sh" "$G"
done
# A migration can rewrite any of the red book: its own commit, so git show reviews it alone.
if [ "$schema" -lt "$SCHEMA" ]; then
  commit "gandalf: migrate the red book to schema $SCHEMA" "$G/red-book" ||
    echo "setup: couldn't commit the migration; left uncommitted" >&2
fi

rm -rf "$G/workflow"
mv "$G/workflow.new" "$G/workflow"
save="$G/workflow/scripts/save"

# Instance-owned: seeded once, never overwritten. The seeded files are committed with this run.
touched=$(printf '%s\n' "$G/workflow" "$G/instance.conf")
seeded=$( (cd "$SRC/seed" && find . -type f) | while IFS= read -r f; do
  if [ ! -e "$G/$f" ]; then
    mkdir -p "$(dirname "$G/$f")"
    cp "$SRC/seed/$f" "$G/$f"
    printf '%s\n' "$G/${f#./}"
  fi
done)
# A bootstrap has nothing else in the instance: commit it all.
[ "$mode" = bootstrap ] && touched=$G

cat > "$G/instance.conf" <<EOF
# gandalf instance; written by setup, don't edit
version=$VERSION
schema=$SCHEMA
source=$SRC
source_commit=$(git -C "$SRC" rev-parse --short HEAD 2>/dev/null || echo unknown)
created=$created
updated=$today
EOF

# Command stubs: one user-level set serves every instance on this machine.
is_stub() { grep -qs 'gandalf-stub' "$1/SKILL.md"; }
ours() { # <path> <link target setup would use>: a gandalf stub, or a broken link setup made
  is_stub "$1" || { [ -L "$1" ] && [ ! -e "$1" ] && [ "$(readlink "$1")" = "$2" ]; }
}
install_stub() { # <stub dir> <target folder>
  dst="$2/$(basename "$1")"
  if [ -e "$dst" ] && ! is_stub "$dst"; then
    echo "setup: skipped $dst: it exists and isn't a gandalf stub" >&2; return 0
  fi
  rm -rf "$dst"
  cp -R "$1" "$dst"
}
link_stub() { # <installed stub> <target folder>
  dst="$2/$(basename "$1")"
  is_stub "$1" || return 0 # install_stub skipped it: the user's own skill, not ours to link
  if { [ -e "$dst" ] || [ -L "$dst" ]; } && ! ours "$dst" "$1"; then
    echo "setup: skipped $dst: it exists and isn't a gandalf stub" >&2; return 0
  fi
  rm -rf "$dst"
  ln -s "$1" "$dst"
}
prune_stubs() { # <folder> [<folder its links point into>]: remove stubs of commands that no longer exist
  for d in "$1"/gandalf-*; do
    [ -e "$d" ] || [ -L "$d" ] || continue
    [ -d "$SRC/stubs/$(basename "$d")" ] && continue
    ours "$d" "${2:-}/$(basename "$d")" && rm -rf "$d"
  done
  return 0
}
stub_dirs=
if [ "$stubs" = yes ]; then
  if [ -n "${GANDALF_STUBS_DIR:-}" ]; then
    mkdir -p "$GANDALF_STUBS_DIR"
    prune_stubs "$GANDALF_STUBS_DIR"
    for s in "$SRC"/stubs/*/; do install_stub "${s%/}" "$GANDALF_STUBS_DIR"; done
    stub_dirs=$GANDALF_STUBS_DIR
  else
    # Real copies in ~/.agents/skills (Codex, opencode), linked into ~/.claude/skills for Claude Code.
    mkdir -p "$HOME/.agents/skills"
    prune_stubs "$HOME/.agents/skills"
    for s in "$SRC"/stubs/*/; do install_stub "${s%/}" "$HOME/.agents/skills"; done
    stub_dirs="$HOME/.agents/skills"
    if [ -d "$HOME/.claude" ]; then
      mkdir -p "$HOME/.claude/skills"
      # One folder linked to the other already serves Claude Code; linking would replace each copy with a
      # link to itself.
      if [ "$(cd -P "$HOME/.claude/skills" && pwd)" != "$(cd -P "$HOME/.agents/skills" && pwd)" ]; then
        prune_stubs "$HOME/.claude/skills" "$HOME/.agents/skills"
        for s in "$SRC"/stubs/*/; do link_stub "$HOME/.agents/skills/$(basename "$s")" "$HOME/.claude/skills"; done
        stub_dirs="$stub_dirs, $HOME/.claude/skills"
      fi
    fi
  fi
fi

# One path per line in $touched and $seeded: split on newlines only.
old_ifs=$IFS; IFS='
'; set -f
# shellcheck disable=SC2086 # word splitting on newlines is intended
set -- $touched $seeded
IFS=$old_ifs; set +f
if [ "$mode" = bootstrap ]; then
  msg="gandalf: bootstrap $VERSION"
else
  msg="gandalf: update ${from:-?} -> $VERSION"
fi
commit "$msg" "$@" || echo "setup: couldn't commit the instance; left uncommitted" >&2
if [ "$mode" = bootstrap ]; then
  echo "setup: created the gandalf instance $VERSION in $G"
else
  echo "setup: updated $G from ${from:-?} to $VERSION"
fi
[ -n "$stub_dirs" ] && echo "setup: command stubs in $stub_dirs"

if [ "$mode" = bootstrap ]; then
  cat <<EOF

Next:
- Claude Code asks before editing files outside the repo you're in. To let gandalf write its red book without
  prompts, add this to ~/.claude/settings.json (merge with what's there):
    "permissions": {
      "additionalDirectories": ["$G"],
      "allow": ["Edit(/$G/red-book/**)", "Write(/$G/red-book/**)", "Bash($G/workflow/scripts/*)"]
    }
- Open a repo below $ROOT and run /gandalf-onboard, then /gandalf-intake <task>.
- Optional: open $G/red-book as an Obsidian vault.
EOF
fi
echo "setup: ok"
