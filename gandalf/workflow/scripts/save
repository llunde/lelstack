#!/bin/sh
# Commit everything in the instance repo: the red book's local history. Only ever this repo, never a project.
# Never pushes: the instance repo has no remote. Retries while another session holds git's lock.
# Usage: save "<message>"
set -eu
msg=${1:?usage: save "<message>"}
g=$(cd "$(dirname "$0")/../.." && pwd -P)
[ -d "$g/.git" ] || { echo "save: the instance has no git repo; skipped"; exit 0; }
i=0
while :; do
  if git -C "$g" add -A && { git -C "$g" diff --cached --quiet || git -C "$g" commit -q -m "$msg"; }; then
    echo "save: ok"; exit 0
  fi
  i=$((i + 1))
  [ "$i" -lt 5 ] || { echo "save: failed after $i tries" >&2; exit 1; }
  sleep 2
done
